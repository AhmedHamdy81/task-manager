# Production environment template — copy to .env and fill in real values.
# Never commit a real .env with secrets.

APP_NAME=BIGbang Studios
APP_ENV=production
FLASK_DEBUG=0

# Required: two different long random secrets. Generate them into a 0600 file with
#   python secrets_migration.py generate --out /secure/path/new-secrets.env
# and copy them in with `apply-env` (see SECURITY.md); never paste them on a command line.
SECRET_KEY=
GOOGLE_SHEETS_TOKEN_KEY=

# Required behind HTTPS
SESSION_COOKIE_SECURE=1
# HttpOnly and SameSite=Lax are always set in code (configure_secure_session)

# Required: host names this server answers to (Host header allowlist; protects
# password-reset and OAuth links). Use ".example.com" to allow subdomains.
ALLOWED_HOSTS=app.example.com

# Reverse proxies (TLS terminators) in front of the app whose X-Forwarded-For/-Proto/-Host
# headers are trusted. 1 for a single nginx/Caddy; 0 if clients connect directly.
TRUSTED_PROXY_COUNT=1

# Required: explicit https:// Socket.IO origins (never *)
# Must match the HTTPS origin loaded by desktop/main.cjs PRODUCTION_APP_URL
# (no PUBLIC_BASE_URL env exists today — keep these two values identical)
SOCKETIO_CORS_ORIGINS=https://app.example.com
# Desktop placeholder until replaced: https://REPLACE_WITH_PRODUCTION_HOST

# Required: comma-separated absolute storage root prefixes
ALLOWED_STORAGE_ROOTS=/Volumes/BigBang_Projects,/Volumes/BigBang_Backup

# Public signup is off by default. To enable intentionally:
ALLOW_PUBLIC_REGISTER=0
# ALLOW_PUBLIC_REGISTER=1
# ALLOW_PUBLIC_REGISTER_CONFIRMED=1

# Bind behind the reverse proxy; do not expose this port directly to the internet.
HOST=127.0.0.1
PORT=5001

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
# 12+ characters; only used to create the first administrator.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: Google / Apple sign-in. Register redirect URIs on the public HTTPS origin:
#   https://app.example.com/login/google/callback
#   https://app.example.com/login/apple/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# APPLE_CLIENT_ID=

# Required for password-reset emails. Use provider credentials or an SMTP relay.
MAIL_ENABLED=1
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=BIGbang Studios <no-reply@example.com>
MAIL_TIMEOUT_SEC=15

# CHAT_CONFERENCE_PROVIDER=jitsi
# CHAT_CONFERENCE_JITSI_BASE_URL=https://meet.jit.si
