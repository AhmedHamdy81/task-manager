# Local development template. Fastest setup (never overwrites an existing .env):
#   python secrets_migration.py init-env
# It copies this file to .env (mode 600) and fills SECRET_KEY and
# GOOGLE_SHEETS_TOKEN_KEY with fresh random values. Never commit .env.

# Application
APP_NAME=BIGbang Studios
APP_ENV=development
# Werkzeug debugger allows code execution: opt in only on a loopback HOST.
FLASK_DEBUG=0

# Required. Session/CSRF/reset-link signing key. Known placeholders and values shorter
# than 32 characters are refused at startup.
SECRET_KEY=

# Required for Google Sheets import (separate from SECRET_KEY; encrypts stored tokens).
# Leave empty to keep Google Sheets off. Changing it later needs secrets_migration.py.
GOOGLE_SHEETS_TOKEN_KEY=

# Network — development stays on loopback. A non-loopback HOST also needs
# ALLOW_NON_LOOPBACK_DEV=1 (and then ALLOWED_HOSTS / SOCKETIO_CORS_ORIGINS for that name).
HOST=127.0.0.1
PORT=5001
# ALLOW_NON_LOOPBACK_DEV=0
# Host names this server answers to (unset = 127.0.0.1, localhost, ::1).
# ALLOWED_HOSTS=
# Socket.IO origins (unset = http://127.0.0.1:PORT, http://localhost:PORT, http://[::1]:PORT).
# Wildcards are refused.
# SOCKETIO_CORS_ORIGINS=
# Reverse proxies in front of the app whose X-Forwarded-* headers are trusted (0 = none).
TRUSTED_PROXY_COUNT=0

# Auth / bootstrap
# Public self-registration is off unless set to 1 (accounts still need approval).
ALLOW_PUBLIC_REGISTER=0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
# Creates the first administrator only when set (12+ characters, not a known default).
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_GUEST_USERS=0
# BOOTSTRAP_GUEST_PASSWORD=

# Session cookies: Secure needs HTTPS. Plain http://127.0.0.1 must keep 0 or sign-in breaks.
SESSION_COOKIE_SECURE=0

# Storage path allowlist (required in production)
# ALLOWED_STORAGE_ROOTS=/Volumes/BigBang_Projects,/Volumes/BigBang_Backup

# Google / Apple sign-in (optional). Redirect URIs:
#   http://127.0.0.1:5001/login/google/callback
#   http://127.0.0.1:5001/login/apple/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# APPLE_CLIENT_ID=

# Optional integrations
# Email & password reset (prefer System Setup: /control/system-setup/email).
# Precedence: MAIL_PASSWORD env > instance/.mail_smtp_password > empty.
# Non-secret options: saved System Setup values override env when non-empty.
# Never commit real credentials. Gmail requires a Google App Password.
MAIL_ENABLED=0
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT_SEC=15

# CHAT_CONFERENCE_PROVIDER=jitsi
# CHAT_CONFERENCE_JITSI_BASE_URL=https://meet.jit.si
