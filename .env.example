# Application
APP_NAME=BIGbang Studios
APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-string

# Network
HOST=127.0.0.1
PORT=5001

# Auth / bootstrap (never use these defaults in production)
ALLOW_PUBLIC_REGISTER=1
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me
# BOOTSTRAP_GUEST_USERS=0
# BOOTSTRAP_GUEST_PASSWORD=replace-me

# Session cookies (set SESSION_COOKIE_SECURE=1 behind HTTPS)
SESSION_COOKIE_SECURE=0

# Socket.IO — comma-separated origins in production, e.g. https://app.example.com
# Use * only for local development. Production rejects *.
SOCKETIO_CORS_ORIGINS=*

# Storage path allowlist (required in production)
# ALLOWED_STORAGE_ROOTS=/Volumes/BigBang_Projects,/Volumes/BigBang_Backup

# Optional integrations
# Email & password reset (prefer System Setup: /control/system-setup?section=email).
# Precedence: MAIL_PASSWORD env > instance/.mail_smtp_password > empty.
# Non-secret options: saved System Setup values override env when non-empty.
# Never commit real credentials. Gmail requires a Google App Password.
MAIL_ENABLED=0
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT_SEC=15

# CHAT_CONFERENCE_PROVIDER=jitsi
# CHAT_CONFERENCE_JITSI_BASE_URL=https://meet.jit.si
